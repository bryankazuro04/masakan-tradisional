  stepSequence:
  - stepId: step_1
    stepTitle: Persiapan Bahan & Oven
    instruction: Siapkan semua bahan dan panaskan oven terlebih dahulu.
    actionType: 0
    requiredTool:
      toolId: tool_loyang
