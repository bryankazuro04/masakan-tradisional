      amount: 1
      unit: secukupnya
      isOptional: 0
      sourceStation: 1
    timeLimitSeconds: 30
    targetTemperature: 0
    stepIllustration: {fileID: 0}
    stepSFX: {fileID: 0}
    fuzzyData: {fileID: 0}
    scoreMultiplier: 1
  - stepId: step_2
    stepTitle: Kocok Adonan Telur & Gula
    instruction: Kocok (mikser) gula pasir dan telur hingga mengembang. Turunkan kecepatan mikser, lalu masukkan tepung terigu, soda kue, dan vanili sedikit demi sedikit.
    actionType: 3
    requiredTool:
      toolId: tool_mixer
      toolName: Mikser & Mangkuk Adonan
      icon: {fileID: 0}
      toolType: Mixer
      sourceStation: 2
    requiredIngredients:
    - ingredientId: ing_gula_pasir
      ingredientName: 115 gram gula pasir
      icon: {fileID: 0}
      amount: 115
      unit: g
      isOptional: 0
      sourceStation: 0
    - ingredientId: ing_tepung_terigu
      ingredientName: 150 gram tepung terigu protein sedang
      icon: {fileID: 0}
      amount: 150
      unit: g
      isOptional: 0
      sourceStation: 0
    - ingredientId: ing_soda_kue
      ingredientName: 1/2 sdt soda kue
      icon: {fileID: 0}
      amount: 0.5
      unit: sdt
      isOptional: 0
      sourceStation: 0
    - ingredientId: ing_vanili
      ingredientName: Secukupnya vanili
      icon: {fileID: 0}
      amount: 1
      unit: secukupnya
      isOptional: 0
      sourceStation: 0
    timeLimitSeconds: 45
    targetTemperature: 0
    stepIllustration: {fileID: 0}
    stepSFX: {fileID: 0}
    fuzzyData: {fileID: 0}
    scoreMultiplier: 1
  - stepId: step_3
    stepTitle: Tambahkan Minyak & Olesi Loyang
    instruction: Tambahkan minyak goreng, mikser hingga tercampur rata, kemudian matikan mikser. Olesi loyang/cetakan dengan mentega tipis-tipis.
    actionType: 3
    requiredTool:
      toolId: tool_loyang
      toolName: Loyang / Cetakan Kue
      icon: {fileID: 0}
      toolType: Baking Mold
      sourceStation: 2
    requiredIngredients:
    - ingredientId: ing_minyak_goreng
      ingredientName: 50 ml minyak goreng
      icon: {fileID: 0}
      amount: 50
      unit: ml
      isOptional: 0
      sourceStation: 0
    timeLimitSeconds: 30
    targetTemperature: 0
    stepIllustration: {fileID: 0}
    stepSFX: {fileID: 0}
    fuzzyData: {fileID: 0}
    scoreMultiplier: 1
  - stepId: step_4
    stepTitle: Panggang Kue di Oven
    instruction: Tuang adonan ke dalam cetakan sebanyak 3/4 bagian. Panggang di dalam oven selama 30 menit pada suhu 280°C dengan api atas bawah hingga matang berwarna kecoklatan.
    actionType: 8
    requiredTool:
      toolId: tool_oven
      toolName: Oven Panggang
      icon: {fileID: 0}
      toolType: Oven
      sourceStation: 4
    requiredIngredients: []
    timeLimitSeconds: 60
    targetTemperature: 280
    stepIllustration: {fileID: 0}
    stepSFX: {fileID: 0}
    fuzzyData: {fileID: 0}
    scoreMultiplier: 1.2
  - stepId: step_5
    stepTitle: Keluarkan & Sajikan Kue
    instruction: Keluarkan kue dari oven, lepaskan dari cetakan, dan sajikan selagi hangat.
    actionType: 9
    requiredTool:
      toolId: tool_loyang
      toolName: Loyang / Cetakan Kue
      icon: {fileID: 0}
      toolType: Baking Mold
      sourceStation: 2
